{
  "name": "@chs/stow",
  "version": "0.0.0",
  "description": "TypeScript client for the stow local S3-compatible dev bucket service",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --experimental-strip-types --test test/integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@smithy/signature-v4": "^5.0.2",
    "@smithy/types": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
